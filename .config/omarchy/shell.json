{
  "version": 1,
  "idle": {
    "screensaver": 600,
    "lock": 900,
    "suspend": 1800
  },
  "bar": {
    "position": "bottom",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "alex.workspaces"
        },
        {
          "id": "omarchy.spacer",
          "size": 40
        },
        {
          "id": "alex.launchers"
        }
      ],
      "center": [
        {
          "id": "alex.sysmon",
          "showVram": true,
          "showGpuMemUtil": true,
          "showCpu": true
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.dropbox"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm:ss",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "alex.suspend"
    }
  ]
}
