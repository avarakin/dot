{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "alex.sysmon",
          "showCpu": true,
          "showGpuMemUtil": false,
          "showVram": true
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "alex.workspaces"
        },
        {
          "id": "omarchy.spacer",
          "size": 40
        },
        {
          "id": "io.github.joeyvigil.taskbar",
          "apps": [
            "code",
            "obsidian",
            {
              "desktopId": "llama-launch",
              "match": "^kitty$"
            },
            "PixInsight"
          ]
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.dropbox"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "format": "dddd HH:mm:ss",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ]
    },
    "position": "bottom",
    "transparent": false
  },
  "idle": {
    "lock": 900,
    "screensaver": 600,
    "suspend": 1800
  },
  "plugins": [
    {
      "id": "alex.suspend"
    }
  ],
  "version": 1
}
